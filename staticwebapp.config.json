{
  "routes": [
    {
      "route": "/crone",
      "allowedRoles": ["crone"]
    },
    {
      "route": "/crone/*",
      "allowedRoles": ["crone"]
    },
    {
      "route": "/journal",
      "allowedRoles": ["crone"]
    },
    {
      "route": "/journal/*",
      "allowedRoles": ["crone"]
    },
    {
      "route": "/grimoire",
      "allowedRoles": ["crone"]
    },
    {
      "route": "/grimoire/*",
      "allowedRoles": ["crone"]
    },
    {
      "route": "/api/crone/*",
      "allowedRoles": ["crone"]
    },
    {
      "route": "/login",
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer"
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout?post_logout_redirect_uri=https://rootandbrass.com/"
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/access-denied.html",
      "statusCode": 403
    }
  }
}
